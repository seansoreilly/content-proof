# Copy to .env.local and fill in. Never commit real secrets.

# --- Required ---
# Google OAuth credentials (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Random secret for session encryption, e.g. `openssl rand -base64 32`
NEXTAUTH_SECRET=
# Public base URL of this deployment
NEXTAUTH_URL=http://localhost:3000
# Ed25519 signing keypair. Generate with the one-liner in README.md.
# Private key: base64 PKCS#8 DER. Public key: base64 SPKI DER.
# In production the app refuses to sign if these are missing;
# in development it generates a throwaway keypair.
ED25519_PRIVATE_KEY=
ED25519_PUBLIC_KEY=

# --- Optional ---
# Comma-separated base64 SPKI DER public keys still accepted after key rotation
ED25519_PUBLIC_KEYS_PREVIOUS=
# Record storage and shared rate limiting (falls back to in-memory when unset).
# Either the KV_* or the UPSTASH_* pair works.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Comma-separated email domains allowed to sign (unset allows all)
ALLOWED_EMAIL_DOMAINS=
# Development-only sign-in bypass; ignored in production
# DEBUG_AUTH=true
# DEBUG_AUTH_EMAIL=dev@example.com
# NEXT_PUBLIC_DEBUG_AUTH=true
# Base URL placed in QR codes (defaults to the current host)
NEXT_PUBLIC_VERIFY_BASE_URL=
# Google Analytics measurement ID (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
